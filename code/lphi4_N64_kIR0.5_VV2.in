# Convergencia: N = 64 con kIR = 0.5 (mismo k máximo que N = 128, kIR = 0.25; caja la mitad)
# Igual que el piloto (code/lphi4_piloto_N128.in) salvo el integrador: con U(1) y GWs CosmoLattice exige VV2.

#Salida
outputfile = ./
print_headers = true
overwriteFiles = false

#Evolución
expansion = true
evolver = VV2

#Red
N = 64
dt = 0.01
kIR = 0.5
kCutOff = 4
baseSeed = 1234

#Tiempos
tMax = 300
tOutputFreq = 0.5
tOutputInfreq = 5

#Espectros
PS_type = 1
PS_version = 1
saveUnbinnedSpectra = false

#GWs
withGWs = true
GWprojectorType = 1

#Condiciones iniciales (inflatón al final de la inflación, GeV y GeV²)
initial_amplitudes = 5.6964e18 0
initial_momenta = -4.86735e30 0

#Modelo
lambda = 9e-14
q = 120
