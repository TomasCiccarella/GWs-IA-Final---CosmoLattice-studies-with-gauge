     // @endlabel
 
+    // Adds vacuum fluctuations to the TRANSVERSE modes of the gauge fields coupled to the SU(2) doublet, on top of the
+    // default initialization (links set to the identity and longitudinal electric field from the Gauss constraint).
+    // This is the non-Abelian analogue of ICtype_U1 = RandomWithMatterTransverseVacuum: the transverse modes, which are
+    // the ones that resonate and source GWs, would otherwise only be seeded at second order.
+    //
+    // The doublet background gives the gauge fields a mass matrix that MIXES the U(1) field A with the SU(2) color
+    // along n^a ~ Phi^dagger sigma^a Phi (as the photon and the Z in the Standard Model). If ICtype_U1 is also
+    // RandomWithMatterTransverseVacuum, the U(1) field is included here and the vacuum is generated in the basis of
+    // mass eigenstates (for g_B = 2 g_A: a massless "photon", a "Z" with m^2 = m_A^2 + m_B^2 and two "W" with m_B^2);
+    // U1Initializer then keeps this transverse part. Otherwise only the three SU(2) colors are included.
+    //
+    // The mass matrix is not hard-coded: it is computed from the homogeneous doublet with the same primitives as
+    // MatterCurrents::U1Current and SU2Current (scalar_prod, i_sigma, complexPhase), linearized in the gauge fields,
+    // so it follows the code's conventions for the doublet, the Pauli matrices and the signs of the links:
+    //   E_A'   = -(f*/w*)^2 [ 2 gA^2 s A + gA gB u_b B^b ],       s   = Im <-i Phi, Phi>,  u_b = Im <i sigma_b Phi, Phi>
+    //   E_B^b' = -(f*/w*)^2 [ gA gB w_b A + gB^2/2 r_ab B^a ],   w_b = Re <-i Phi, i sigma_b Phi>,
+    //                                                            r_ab = Re <i sigma_a Phi, i sigma_b Phi>
+    // (program units, a = 1; <x, y> is scalar_prod). The matrix must come out symmetric (u = w), which is checked.
+    // Conventions for the SU(2) field (FieldFunctionals::B2SU2, pi2SU2, SU2Kernels and the exponential map of the
+    // evolvers): the algebra components of the link are g dx B^b / 2 and piSU2 holds E^b / 2.
+    // Each eigenmode is generated like the U(1) case (two transverse polarizations, plane waves with its mass and
+    // aDot = 0). The transverse part has zero backward-lattice divergence, so the Abelian part of the Gauss constraint
+    // is untouched; the non-Abelian term g [B, E] makes it change at second order in these fluctuations.
+    // The random seeds depend on the name of the scratch fields, so each eigenmode gets its own names and hence
+    // independent noise, also independent of the scalar fluctuations.
+    template <class Model, typename T>
+    static void addTransverseVacuumSU2(Model &model, FluctuationsGenerator<T> &fg, T kCutOff, RunParameters<T> &rPar)
+    {
+      static_assert(Model::NSU2 == 1 && Model::NSU2Doublet == 1,
+                    "The SU(2) transverse vacuum is only implemented for one SU(2) field and one doublet.");
+      using VF = VectorField<Field<T, Model::NDim>>;
+      const T amp = transverseVacuumTestAmplitude<T>();
+
+      bool withU1 = false;
+      if constexpr (Model::NU1 > 0) {
+        static_assert(Model::NU1 == 1, "The SU(2) transverse vacuum is only implemented with at most one U(1) field.");
+        withU1 = rPar.U1IC == InitialConditionsType::U1::RandomWithMatterTransverseVacuum;
+      }
+      const int off = withU1 ? 1 : 0; // index 0 is A if withU1, then B^1, B^2, B^3
+      const int D = 3 + off;
+
+      // 1. Mass matrix (program units).
+      auto phi = model.fldSU2Doublet(0_c);
+      const T norm2 = pow<2>(model.fStar / model.omegaStar);
+      const T gB = model.gQ_SU2DblSU2(0_c, 0_c);
+      std::array<std::array<T, 4>, 4> M{};
+      ForLoop(a, 1, 3,
+              ForLoop(b, 1, 3,
+                      M[off + (int)a - 1][off + (int)b - 1] =
+                          norm2 * gB * gB / 2 *
+                          average(Real(scalar_prod(Constants::i_sigma(a) * phi, Constants::i_sigma(b) * phi)));));
+      if constexpr (Model::NU1 > 0)
+        if (withU1) {
+          const T gA = model.gQ_SU2DblU1(0_c, 0_c);
+          auto minusIPhi = complexPhase(T(0) * model.fldU1(0_c)(1_c) - Constants::pi<T> / 2) * phi;
+          M[0][0] = 2 * norm2 * gA * gA * average(Imag(scalar_prod(minusIPhi, phi)));
+          ForLoop(b, 1, 3, const T u = average(Imag(scalar_prod(Constants::i_sigma(b) * phi, phi)));
+                  const T w = average(Real(scalar_prod(minusIPhi, Constants::i_sigma(b) * phi)));
+                  M[0][(int)b] = norm2 * gA * gB * u; M[(int)b][0] = norm2 * gA * gB * w;);
+        }
+      say << "Gauge mass matrix from the doublet background (program units; A, B1, B2, B3):";
+      for (int i = 0; i < D; ++i) {
+        std::string row;
+        for (int j = 0; j < D; ++j) row += " " + std::to_string(M[i][j]);
+        say << "  " << row;
+      }
+      T asym = 0, scale = 0;
+      for (int i = 0; i < D; ++i)
+        for (int j = 0; j < D; ++j) {
+          asym = std::max(asym, std::abs(M[i][j] - M[j][i]));
+          scale = std::max(scale, std::abs(M[i][j]));
+        }
+      if (asym > 1e-6 * scale)
+        throw(RunParametersInconsistent("The gauge mass matrix from the doublet is not symmetric, abort."));
+
+      // 2. Eigenmodes (Jacobi rotations on the symmetrized matrix).
+      std::array<std::array<T, 4>, 4> O{};
+      for (int i = 0; i < D; ++i) O[i][i] = 1;
+      for (int i = 0; i < D; ++i)
+        for (int j = 0; j < D; ++j) M[i][j] = (M[i][j] + M[j][i]) / 2;
+      for (int sweep = 0; sweep < 50; ++sweep)
+        for (int p = 0; p < D; ++p)
+          for (int q = p + 1; q < D; ++q) {
+            if (std::abs(M[p][q]) < 1e-14 * scale) continue;
+            const T theta = (M[q][q] - M[p][p]) / (2 * M[p][q]);
+            const T t = (theta >= 0 ? 1 : -1) / (std::abs(theta) + std::sqrt(theta * theta + 1));
+            const T c = 1 / std::sqrt(t * t + 1), s = t * c;
+            for (int k = 0; k < D; ++k) { // M <- J^T M J, O <- O J
+              const T mkp = M[k][p], mkq = M[k][q];
+              M[k][p] = c * mkp - s * mkq;
+              M[k][q] = s * mkp + c * mkq;
+            }
+            for (int k = 0; k < D; ++k) {
+              const T mpk = M[p][k], mqk = M[q][k];
+              M[p][k] = c * mpk - s * mqk;
+              M[q][k] = s * mpk + c * mqk;
+            }
+            for (int k = 0; k < D; ++k) {
+              const T okp = O[k][p], okq = O[k][q];
+              O[k][p] = c * okp - s * okq;
+              O[k][q] = s * okp + c * okq;
+            }
+          }
+
+      // 3. Vacuum of each eigenmode, rotated back to A and B^b.
+      const T gdx2 = gB * model.dx / 2;
+      for (int k = 0; k < D; ++k) {
+        const T mass2 = std::abs(M[k][k]) < 1e-9 * scale ? T(0) : M[k][k];
+        std::string vec;
+        for (int i = 0; i < D; ++i) vec += " " + std::to_string(O[i][k]);
+        say << "Transverse vacuum, gauge eigenmode " << k << ": mass^2 = " << mass2 << ", components (A, B1, B2, B3):" << vec;
+
+        const std::string tag = "SU2ICvacModo" + std::to_string(k);
+        VF X(tag + "X", model.getToolBox(), rPar.getLatParams());
+        VF P(tag + "P", model.getToolBox(), rPar.getLatParams());
+        VF tmpX(tag + "tmpX", model.getToolBox(), rPar.getLatParams());
+        VF tmpP(tag + "tmpP", model.getToolBox(), rPar.getLatParams());
+        fg.planeWaves(model, X, P, tmpX, tmpP, T(0), kCutOff, mass2);
+
+        if constexpr (Model::NU1 > 0)
+          if (withU1) {
+            const T oA = amp * O[0][k];
+            ForLoop(i, 1, Model::NDim, model.fldU1(0_c)(i) = model.fldU1(0_c)(i) + oA * X(i);
+                    model.piU1(0_c)(i) = model.piU1(0_c)(i) + oA * P(i););
+          }
+        ForLoop(b, 1, 3, const T oB = amp * O[off + (int)b - 1][k];
+                ForLoop(i, 1, Model::NDim,
+                        model.fldSU2(0_c)(i)(b) = model.fldSU2(0_c)(i)(b) + oB * gdx2 * X(i);
+                        model.piSU2(0_c)(i)(b) = model.piSU2(0_c)(i)(b) + oB * P(i) / 2;););
+      }
+      // Recompute c0 = sqrt(1 - |c|^2) so that the links are unitary again.
+      ForLoop(i, 1, Model::NDim, model.fldSU2(0_c)(i).unitarize(););
+    }
+
     // INITIALIZATION: SU2 doublets
     // --> Note: aDot has to be initialized before calling this function.
     // @label:su2initializer_doublet
