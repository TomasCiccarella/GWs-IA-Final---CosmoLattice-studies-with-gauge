+    // Same as RandomWithMatter (charged scalars + longitudinal electric field from the Gauss constraint), plus vacuum
+    // fluctuations in the TRANSVERSE modes of the U(1) gauge fields (amplitudes and time-derivatives). Transverse modes
+    // (w.r.t. the backward lattice momentum) have zero lattice divergence, so the Gauss constraint is untouched.
+    // Each polarization is initialized like a scalar singlet with the effective gauge mass of the homogeneous
+    // background, m_A^2 = 2 (gQ)^2 |Phi_0|^2 / omega_*^2 (program units, a = 1), and with aDot = 0 because the gauge
+    // field is conformal (no a'/a term in its conjugate momentum). This puts the gauge fields on the same footing as
+    // scalar daughter fields, which start from their vacuum fluctuations. The random seeds of the transverse modes are
+    // independent of those of the scalars, so the scalar fluctuations are identical to the RandomWithMatter ones.
+    template <class Model, typename T>
+    static void initializeRandomWithMatterTransverseVacuumU1(Model &model, FluctuationsGenerator<T> &fg, T kCutOff,
+                                                            ExtraFields<Model> extraFlds)
+    {
+      if constexpr (Model::NU1 > 0) {
+        auto tmpA = extraFlds.fldForPlaneWavesU1();
+        auto tmpE = extraFlds.piForPlaneWavesU1();
+        // 1. Transverse vacuum, generated directly into the gauge fields (tmpA, tmpE are used as scratch).
+        ForLoop(n, 0, Model::NU1 - 1, T mass2 = 0;
+                ForLoop(c, 0, Model::NCs - 1,
+                        mass2 += 2 * pow<2>(static_cast<T>(model.gQ_CsU1(c, n))) *
+                                 (pow<2>(model.fldCS0(c)(0_c)) + pow<2>(model.fldCS0(c)(1_c))) /
+                                 pow<2>(model.omegaStar););
+                say << "Transverse vacuum for U(1) field " << (int)n << ": effective mass^2 = " << mass2
+                    << " (program units).";
+                fg.planeWaves(model, model.fldU1(n), model.piU1(n), tmpA, tmpE, T(0), kCutOff, mass2););
+        // 2. Default initialization (overwrites the gauge fields), keeping the transverse part aside. With more than
+        //    one U(1) field the scratch holds one field at a time, so we only support NU1 == 1 here.
+        static_assert(Model::NU1 == 1, "RandomWithMatterTransverseVacuum is only implemented for one U(1) field.");
+        ForLoop(i, 1, Model::NDim, tmpA(i) = model.fldU1(0_c)(i); tmpE(i) = model.piU1(0_c)(i););
+        initializeRandomWithMatterU1(model, fg, kCutOff);
+        // 3. Add the transverse part back.
+        ForLoop(i, 1, Model::NDim, model.fldU1(0_c)(i) += tmpA(i); model.piU1(0_c)(i) += tmpE(i););
+      }
+    }
